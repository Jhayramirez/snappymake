{
  "manifest_version": 3,
  "name": "SnappyMake IMAP Verifier",
  "version": "1.0.0",
  "description": "Shows the latest Snapchat verification link and OTP code for the Gmail tied to the open AdsPower profile.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnappyMake IMAP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
