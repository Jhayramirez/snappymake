#!/usr/bin/env bash
# SnappyMake Gmail pipeline launcher
#   bash ./run fake    → live Gmail API / 2FA / batch HUD
set -euo pipefail

mode="${1:-}"
if [[ "$mode" != "fake" && "$mode" != "gmail" && "$mode" != "bypass" ]]; then
  echo "usage: bash ./run fake"
  exit 1
fi

C=$'\033[36m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; B=$'\033[1m'; D=$'\033[2m'; N=$'\033[0m'
ts() { date '+%H:%M:%S'; }
say() { printf '%s%s%s %s\n' "$D" "$(ts)" "$N" "$*"; }
ok()  { printf '%s%s%s  %sOK%s  %s\n' "$D" "$(ts)" "$N" "$G" "$N" "$*"; }
inf() { printf '%s%s%s  %sAPI%s %s\n' "$D" "$(ts)" "$N" "$C" "$N" "$*"; }
warn(){ printf '%s%s%s  %s..%s  %s\n' "$D" "$(ts)" "$N" "$Y" "$N" "$*"; }
slow() { local n="${1:-0.04}"; shift; local s="$*"; local i; for ((i=0;i<${#s};i++)); do printf '%s' "${s:i:1}"; sleep "$n"; done; printf '\n'; }
bar() {
  local label="$1" total="${2:-24}"
  printf '         %s%-22s%s [' "$D" "$label" "$N"
  local i
  for ((i=0;i<total;i++)); do printf '%s█%s' "$G" "$N"; sleep 0.03; done
  printf '] %s100%%%s\n' "$G" "$N"
}

clear
printf '%s' "$C$B"
cat <<'BANNER'
   _____ ____  ___    ____  _____  ______
  / ___// __ \/   |  / __ \/ __ \/ ____/  GMAIL API
  \__ \/ / / / /| | / /_/ / /_/ / / __    identity · oauth2 · totp
 ___/ / /_/ / ___ |/ ____/ ____/ /_/ /    snappymake pipeline
/____/_____/_/  |_/_/   /_/    \____/

BANNER
printf '%s' "$N"
say "${B}snappy-gmail${N}  runtime  v3.8.1  ·  region us-central1  ·  mode=live"
sleep 0.25
ok "kernel attached  pid=$$  tty=$(tty 2>/dev/null | sed 's|.*/||')"
ok "ads layer  local.adspower.net:50325  ·  cdp ready"
sleep 0.35

inf "GET  https://gmail.googleapis.com/gmail/v1/users/me/profile"
sleep 0.45
printf '%s         %s{\n' "$D" "$N"
printf '           "emailAddress": "pipeline-bot@snappy.internal",\n'
printf '           "messagesTotal": 48122,\n'
printf '           "threadsTotal": 9021,\n'
printf '           "historyId": "1948302"\n'
printf '         }\n'
ok "gmail.users.getProfile  200  scope=https://mail.google.com/"
sleep 0.3

inf "POST https://oauth2.googleapis.com/token"
sleep 0.4
ok "grant_type=refresh_token  →  access_token  ya29.${G}••••••••••••••••${N}  exp=3599s"
ok "scope  gmail.modify  gmail.settings.basic  https://www.googleapis.com/auth/userinfo.email"
sleep 0.25

say "${B}2FA / TOTP bridge${N}  rfc6238  ·  2fa.cn compatible  ·  period=30s"
bar "seed decode" 18
ok "secrets loaded  4  ·  backup-codes fallback  armed"
sleep 0.2

say "${B}batch${N}  Second Batch  ·  4 mailbox(es)"
sleep 0.35

run_one() {
  local n="$1" email="$2" secret="$3" code="$4"
  echo
  say "${B}$n/4${N}  $C$email$N"
  inf "users.messages.list  q=in:inbox  maxResults=1"
  sleep 0.35
  warn "challenge  totp  /v3/signin/challenge/totp"
  sleep 0.25
  inf "totp.generate  secret=${secret:0:8}••••  window=$(date +%s)"
  sleep 0.4
  ok "code  $G$code$N  remaining=$(( RANDOM % 12 + 8 ))s"
  inf "POST  /gmail/v1/users/me/messages/send  (auth handshake)"
  sleep 0.45
  ok "LOGIN_OK  inbox  https://mail.google.com/mail/u/0/#inbox"
  warn "proxy inject  netlox  sticky=10080"
  sleep 0.4
  ok "proxy  up  tls  egress ok"
  inf "oauth.google  client_id=1264653537-••••.apps.googleusercontent.com"
  sleep 0.5
  ok "Sign up with Google  →  snap  connected"
  ok "confirm_email  opened  ·  verified"
}

run_one 1 "narrownaus@gmail.com"    "32ID2VTM" "529616"
run_one 2 "summersomao@gmail.com"   "5EUCG2YM" "353926"
run_one 3 "cautionsau@gmail.com"    "YQDNHJR5" "918204"
run_one 4 "eusoelakso@gmail.com"    "CJL2FEUJ" "441033"

echo
say "${B}summary${N}"
printf '         %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$D" "$N"
printf '         mailboxes     %s4/4%s\n' "$G" "$N"
printf '         gmail api     %sauthenticated%s\n' "$G" "$N"
printf '         2fa totp      %sbypassed via seed%s\n' "$G" "$N"
printf '         snap signup   %s4 created%s\n' "$G" "$N"
printf '         proxy         %snetlox live%s\n' "$G" "$N"
printf '         %s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$D" "$N"
ok "pipeline idle  ·  session kept  ·  press ctrl-c to detach"
echo
slow 0.018 "${D}snappy-gmail>${N} ${G}ready${N}"
# keep the prompt looking live
while true; do sleep 3600; done
