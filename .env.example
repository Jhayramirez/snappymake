# AdsPower Local API — leave blank to auto-detect localhost:50325
ADSPOWER_API_BASE=http://127.0.0.1:50325
ADSPOWER_API_KEY=

# Optional. Leave 0 if you don't know your premium cap yet.
# Remaining slots = cap - current profile count.
ADSPOWER_PLAN_CAP=0

# Dashboard
SNAPPYMAKE_HOST=127.0.0.1
SNAPPYMAKE_PORT=8787
SNAPPYMAKE_GROUP_NAME=SnappyMake

# Snapchat signup password used when Auto password is on (or the field is empty)
SNAPCHAT_DEFAULT_PASSWORD=PCGpp00##

# Optional. Gmail IMAP for Snapchat OTP (accounts live in data/gmail_accounts.txt)
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
